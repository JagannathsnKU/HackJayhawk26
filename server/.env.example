# MongoDB Atlas — create a cluster, database user, and get your connection string.
# Network Access: allow your IP (or 0.0.0.0/0 for dev only).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/hackjayhawk?retryWrites=true&w=majority

# Use a long random string in production (e.g. openssl rand -base64 48).
JWT_SECRET=replace-with-a-long-random-secret

PORT=5000
